{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "",
    "color": {
      "output": "38;2;235;235;235",
      "separator": "38;2;136;21;21"
    },
    "percent": {
      "type": 11,
      "green": 50,
      "yellow": 80,
      "color": {
        "green": "38;2;235;235;235",
        "yellow": "38;2;232;22;23",
        "red": "38;2;136;21;21"
      }
    },
    "bar": {
      "charElapsed": "\u2501",
      "charTotal": "\u2500",
      "borderLeft": "",
      "borderRight": "",
      "width": 12
    },
    "brightColor": false,
    "size": {
      "ndigits": 1
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": " ",
      "format": "\u001b[2G\u001b[38;2;136;21;21m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[3G\u2500 \u001b[1;38;2;232;22;23m{user-name}\u001b[38;2;235;235;235m@{host-name} \u001b[0m"
    },
    {
      "type": "host",
      "keyColor": "38;2;136;21;21",
      "key": "\u001b[31G\u2502\u001b[2G\u2502 \u001b[38;2;232;22;23m\udb80\udf22  ",
      "format": "{family}"
    },
    {
      "type": "os",
      "keyColor": "38;2;136;21;21",
      "key": "\u001b[31G\u2502\u001b[2G\u2502 \u001b[38;2;232;22;23m\uf306  ",
      "format": "Debian {version-id} {codename}"
    },
    {
      "type": "kernel",
      "keyColor": "38;2;136;21;21",
      "key": "\u001b[31G\u2502\u001b[2G\u2502 \u001b[38;2;232;22;23m\uf17c  ",
      "format": "{release}"
    },
    {
      "type": "custom",
      "format": "\u001b[2G\u001b[38;2;136;21;21m\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[0m"
    },
    {
      "type": "wm",
      "keyColor": "38;2;136;21;21",
      "key": "\u001b[31G\u2502\u001b[2G\u2502 \u001b[38;2;232;22;23m\uf2d0  ",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "keyColor": "38;2;136;21;21",
      "key": "\u001b[31G\u2502\u001b[2G\u2502 \u001b[38;2;232;22;23m\uf489  ",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "keyColor": "38;2;136;21;21",
      "key": "\u001b[31G\u2502\u001b[2G\u2502 \u001b[38;2;232;22;23m\udb80\udd8d  ",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "custom",
      "format": "\u001b[2G\u001b[38;2;136;21;21m\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[0m"
    },
    {
      "type": "command",
      "keyColor": "38;2;136;21;21",
      "key": "\u001b[31G\u2502\u001b[2G\u2502 \u001b[38;2;232;22;23m\udb81\ude1a  ",
      "text": "awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo | sed -E 's/\\((R|TM)\\)//g; s/^[0-9]+th Gen //; s/ Core / /; s/ +/ /g'"
    },
    {
      "type": "gpu",
      "keyColor": "38;2;136;21;21",
      "key": "\u001b[31G\u2502\u001b[2G\u2502 \u001b[38;2;232;22;23m\udb82\udcae  ",
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "keyColor": "38;2;136;21;21",
      "key": "\u001b[31G\u2502\u001b[2G\u2502 \u001b[38;2;232;22;23m\udb80\udf5b  ",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "keyColor": "38;2;136;21;21",
      "key": "\u001b[31G\u2502\u001b[2G\u2502 \u001b[38;2;232;22;23m\udb80\udeca  ",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "custom",
      "format": "\u001b[2G\u001b[38;2;136;21;21m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m"
    },
    "break"
  ]
}
