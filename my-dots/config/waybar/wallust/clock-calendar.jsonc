// generated by ~/.config/fastfetch/gen_config.py from the wallpaper
{
  "clock#forest": {
    "format": "{:L%A %d.%m.%Y - %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ebebeb'><b>{}</b></span>",
        "days": "<span color='#cfcfcf'>{}</span>",
        "weekdays": "<span color='#e81617'><b>{}</b></span>",
        "today": "<span background='#d11415' color='#ebebeb'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-right": "shift_reset"
    }
  }
}
